# ==============================================================================
# Relay WhatsApp Dispatcher — Cloud Environment Configuration
# Copy this file to .env before deploying with Coolify / Docker Compose
# ==============================================================================

# Enable strict authentication middleware (1 = enabled, 0 = disabled)
RELAY_ENABLE_AUTH=1

# Optional Master Access Key / Password for direct login or API calls
# Generate a strong key with: openssl rand -hex 16
RELAY_AUTH_KEY=change-this-to-a-secure-random-token

# Allowed Tailscale User Logins (comma-separated emails)
# If left empty, any authenticated user on your private tailnet can access Relay.
# Example: ALLOWED_TAILSCALE_USERS=you@gmail.com,partner@gmail.com
ALLOWED_TAILSCALE_USERS=

# Headless browser mode (1 = headless for cloud/server, 0 = visible browser)
RELAY_HEADLESS=1

# Storage directory inside container for persistent database, uploads, and browser sessions
RELAY_USER_DATA_DIR=/data

# Timezone (e.g. UTC, America/New_York, Europe/London, Asia/Kolkata)
TZ=UTC
